# API keys — copy this file to .env and fill in. NEVER commit .env.

# Hugging Face token — gated model downloads you start in Setup.
# Publishing is excluded from this fork. Leave empty when every weight is local.
HF_TOKEN=

# Upstream's full-model cloud-training token. Saving it from Settings is refused
# and the value is not stored. Leave it empty.
HF_CLOUD_TOKEN=

# Unused in this fork. Online image imports are excluded.
PEXELS_API_KEY=

# Optional Civitai token for a model download you start in Setup.
# Browsing and scraping do not use it.
CIVITAI_API_KEY=
