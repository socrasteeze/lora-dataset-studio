{
  "app": "lora-dataset-studio",
  "kind": "training-preset",
  "version": 1,
  "name": "Anima Character Automagic3",
  "train_type": "anima",
  "dataset_kind": "character",
  "variants": [],
  "settings": {
    "network_type": "lora",
    "rank": 32,
    "alpha": 32,
    "conv": 16,
    "conv_alpha": 16,
    "ignore_if_contains": [
      "norm1.linear",
      "norm2.linear",
      "norm3.linear",
      "norm_out.linear",
      "patch_embed",
      "time_embed",
      "proj_out"
    ],
    "resolution": "1024",
    "preset_steps_fixed": 1000,
    "save_every": 100,
    "max_step_saves": 4,
    "save_dtype": "float16",
    "batch_size": 4,
    "grad_accum": 1,
    "gradient_checkpointing": true,
    "optimizer": "automagic3",
    "learning_rate": 0.00002,
    "min_lr": 0.000001,
    "max_lr": 0.00002,
    "weight_decay": 0.0001,
    "timestep_type": "sigmoid",
    "lr_scheduler": "constant",
    "loss_type": "mse",
    "loss_sync_every": 4,
    "caption_dropout_rate": 0,
    "cache_latents": true,
    "cache_text_embeddings": true,
    "unload_text_encoder": false,
    "bypass_guidance_embedding": true,
    "masked": false,
    "mask_faces": false,
    "dual_captions": false,
    "quantize": false,
    "quantize_te": false,
    "low_vram": false,
    "compile": false,
    "ema": "off",
    "sample_every": 250,
    "sample_steps": 30,
    "sample_guidance": 4,
    "sample_width": 832,
    "sample_height": 1216,
    "sample_seed": 42,
    "sample_walk_seed": true,
    "sample_negative_prompt": "",
    "skip_first_sample": true
  }
}
